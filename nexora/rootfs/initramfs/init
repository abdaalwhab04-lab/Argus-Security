#!/bin/sh

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mount -t tmpfs tmpfs /run

echo "================================"
echo "       NEXORA Linux"
echo "================================"
echo "NEXORA initramfs started."
echo "NEXORA_BOOT_OK"

echo "=== Waiting for NEXORA ISO ==="

i=0
while [ ! -b /dev/sr0 ] && [ "$i" -lt 10 ]; do
    sleep 1
    i=$((i + 1))
done

if [ ! -b /dev/sr0 ]; then
    echo "ERROR: /dev/sr0 not found"
    echo "NEXORA_ROOTFS_NOT_FOUND"
    exec /bin/sh
fi

mkdir -p /mnt

echo "=== Mounting Debian RootFS ==="

mount -t iso9660 -o ro /dev/sr0 /mnt

if [ ! -f /mnt/etc/debian_version ]; then
    echo "ERROR: Debian RootFS not found on ISO"
    echo "NEXORA_ROOTFS_NOT_FOUND"
    exec /bin/sh
fi

echo "NEXORA_DEBIAN_ROOTFS_FOUND"

echo "=== Prepare persistent Debian storage ==="

i=0
while [ ! -b /dev/vda ] && [ "$i" -lt 20 ]; do
    sleep 1
    i=$((i + 1))
done

if [ ! -b /dev/vda ]; then
    echo "ERROR: persistent NEXORA data disk /dev/vda not found"
    echo "NEXORA_PERSISTENT_STORAGE_FAILED"
    exec /bin/sh
fi

mkdir -p /persist
if ! mount -t ext4 -o rw /dev/vda /persist; then
    echo "ERROR: unable to mount persistent NEXORA data disk"
    echo "NEXORA_PERSISTENT_STORAGE_FAILED"
    exec /bin/sh
fi

mkdir -p /persist/overlay/upper /persist/overlay/work
# Docker's overlay2 storage must live directly on the ext4 persistent disk.
# Keeping /var/lib/docker inside the outer NEXORA overlayfs makes Docker see
# an overlay-backed filesystem and fall back to the vfs storage driver.
mkdir -p /persist/docker /persist/containerd
mkdir -p /newroot

echo "=== Mount writable Debian overlay ==="
if ! mount -t overlay overlay -o lowerdir=/mnt,upperdir=/persist/overlay/upper,workdir=/persist/overlay/work /newroot; then
    echo "ERROR: unable to mount Debian writable overlay"
    echo "NEXORA_PERSISTENT_OVERLAY_FAILED"
    exec /bin/sh
fi

mkdir -p /newroot/dev /newroot/proc /newroot/sys /newroot/run /newroot/persist
mount --bind /dev /newroot/dev
mount --bind /proc /newroot/proc
mount --bind /sys /newroot/sys
mount --bind /run /newroot/run
mount --bind /persist /newroot/persist

mkdir -p /newroot/var/lib/docker /newroot/var/lib/containerd
mount --bind /persist/docker /newroot/var/lib/docker
mount --bind /persist/containerd /newroot/var/lib/containerd

echo "NEXORA_PERSISTENT_STORAGE_OK"
echo "NEXORA_DOCKER_CONFIG_OK"
echo "NEXORA_DOCKER_STORAGE_OK"
echo "NEXORA_ROOTFS_SWITCH"

exec switch_root /newroot /sbin/init
